# ---------------------------------------------------------------------------
# Keesa environment variables
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must never be committed. On Vercel, set these in
# Project Settings → Environment Variables.
#
# NEXT_PUBLIC_* variables are exposed to the browser. Everything else is
# server-only and must never be referenced from client components.
# ---------------------------------------------------------------------------

# Canonical, absolute site URL (no trailing slash). Used for metadata,
# Open Graph, canonical URLs, robots.txt, and sitemap generation.
# Local: http://localhost:3000 — Production: https://keesa.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Sanity CMS -----------------------------------------------------------
# Project ID and dataset are safe to expose to the browser.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version, pinned as a date (YYYY-MM-DD). Bump deliberately.
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only read token for fetching drafts / private content.
# NEVER prefix this with NEXT_PUBLIC_ and never import it into client code.
SANITY_API_READ_TOKEN=
